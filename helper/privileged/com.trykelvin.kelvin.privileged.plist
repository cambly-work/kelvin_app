<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trykelvin.kelvin.privileged</string>

    <key>MachServices</key>
    <dict>
        <key>com.trykelvin.kelvin.privileged</key>
        <true/>
    </dict>

    <!-- SMAppService resolves BundleProgram relative to Kelvin.app. -->
    <key>BundleProgram</key>
    <string>Contents/Library/LaunchDaemons/com.trykelvin.kelvin.privileged</string>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/var/log/kelvin-privileged.log</string>

    <key>StandardOutPath</key>
    <string>/var/log/kelvin-privileged.log</string>
</dict>
</plist>
