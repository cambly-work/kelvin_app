<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Разрешение на использование ServiceManagement для регистрации демонов -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TeamIdentifierPrefix)com.trykelvin.kelvin</string>
    </array>
    
    <!-- Наследование прав от родителя (важно для XPC) -->
    <key>com.apple.security.inherit</key>
    <true/>
    
    <!-- Доступ к сети (если нужен для firewall rules или hosts) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- Доступ к файловой системе для чтения конфигов -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Отладка (удалить перед релизом в App Store, оставить для Dev) -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
