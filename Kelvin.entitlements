<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Под hardened runtime отправка Apple Events наружу (System Events для тёмной темы,
         Terminal для Homebrew/команд, Finder для кастомных команд) разрешена ТОЛЬКО при наличии
         этого entitlement. Без него нотаризованная сборка молча получает ошибку -1743.
         NSAppleEventsUsageDescription в Info.plist даёт TCC-промпт, но не снимает hardened-блок. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    
    <!-- Application Groups для обмена данными с Privileged Service через XPC -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TeamIdentifierPrefix)com.trykelvin.kelvin</string>
    </array>
    
    <!-- Наследование прав от родителя (важно для XPC communication) -->
    <key>com.apple.security.inherit</key>
    <true/>
    
    <!-- Доступ к сети для firewall rules и host blocklist -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- Доступ к файловой системе для чтения/записи конфигов -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Hardened Runtime: доступ к системным настройкам (для pmset, networksetup) -->
    <key>com.apple.security.temporary-exception.system-configuration</key>
    <true/>
    
    <!-- Отладка (удалить перед релизом в App Store, оставить для Dev/Notarization) -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
