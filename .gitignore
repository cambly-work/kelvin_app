# Build artifacts
build/
dist/
*.o
*.obj
*.out

# Built applications (rebuilt from Sources/ — never commit compiled bundles)
Kelvin.app/
BatteryMeter.app/
*.app/

# Distribution archives
*.dmg
*.zip
*.pkg

# dSYMs / symbol archives
*.dSYM/
dsyms/
*.dSYM.zip

# Dependencies
Packages/
.build/

# Logs and temp files
*.log
*.tmp
.kelvin-*

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage
.coverage
coverage/
htmlcov/

# Xcode/Swift specific
*.swiftdoc
*.swiftmodule
DerivedData/

# Secrets — Sparkle EdDSA keys (private+public). Generated by tools/generate_*.
# MUST never be committed: утечка приватного ключа = подделка обновлений.
update_keys.txt
update_keys/
update_keys/*.pem

# Generated appcast (built by release.sh per-version)
docs/appcast.xml

# macOS
.DS_Store
