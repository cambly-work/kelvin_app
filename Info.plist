<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>            <string>Kelvin</string>
    <key>CFBundleDisplayName</key>     <string>Kelvin</string>
    <key>CFBundleIdentifier</key>      <string>com.trykelvin.kelvin</string>
    <key>CFBundleExecutable</key>      <string>Kelvin</string>
    <key>CFBundleIconFile</key>        <string>AppIcon</string>
    <key>CFBundleIconName</key>        <string>AppIcon</string>
    <key>CFBundleVersion</key>         <string>900</string>
    <key>CFBundleShortVersionString</key><string>0.9.0</string>
    <key>CFBundlePackageType</key>     <string>APPL</string>
    <key>NSHumanReadableCopyright</key><string>© 2026 Kelvin · Artem Balabanov</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
    <key>LSUIElement</key>             <true/>
    <key>LSMinimumSystemVersion</key>  <string>11.0</string>
    <key>NSHighResolutionCapable</key> <true/>
    <key>NSSupportsAutomaticTermination</key><false/>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Kelvin показывает статус Bluetooth и позволяет включать/выключать его из строки меню.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Kelvin использует системные команды для переключателей (тёмная тема, Night Shift и др.).</string>

    <!-- SMJobBless pairing (legacy macOS 11-12). Dev builds use the stable helper
         identifier; release.sh/build.sh strengthen this requirement with Team ID. -->
    <key>SMPrivilegedExecutables</key>
    <dict>
        <key>com.trykelvin.kelvin.privileged</key>
        <string>identifier "com.trykelvin.kelvin.privileged"</string>
    </dict>

    <!-- Sparkle updater settings -->
    <key>SUFeedURL</key>
    <string>https://trykelvin.com/appcast.xml</string>
    <!-- SUPublicEDKey: вшивается автоматически release.sh из публичного EdDSA-ключа
         (переменная SUPUBLIC_ED_KEY или PUBLIC_KEY в SPARKLE_ED_KEY_FILE) ПОСЛЕ сборки,
         непосредственно в собранный бандл, с последующей переподписью. Не задавайте
         здесь вручную — оставьте plist валидным без ключа до сборки релиза. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUHasLaunchedBefore</key>
    <true/>
    <key>SUSendProfileInfo</key>
    <false/>
    <key>SUEnableInstallerLauncherService</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
</dict>
</plist>
